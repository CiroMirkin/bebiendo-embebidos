---
import InlineMd from '../../components/InlineMd.astro';
import LevelBadge from '../../components/LevelBadge.astro';
import Base from '../../layouts/Base.astro';
import { getConceptsByPart } from '../../content/concepts';
import { getAllPartSlugs, getPartBySlug, partLabel, type Part } from '../../content/parts';
import { resumir } from '../../lib/markdown';
import { migas, tituloDePagina, urlDePagina } from '../../lib/seo';

export const getStaticPaths = () =>
  getAllPartSlugs().map((part) => ({ params: { part } }));

const part = getPartBySlug(Astro.params.part) as Part;
const concepts = await getConceptsByPart(part.slug);
const titulo = `${partLabel(part)}: ${part.title}`;
const jsonLd = [
  migas([
    { nombre: 'Inicio', url: new URL('/', Astro.site) },
    { nombre: titulo, url: urlDePagina(Astro.url.pathname, Astro.site) },
  ]),
];
---

<Base titulo={tituloDePagina(titulo)} descripcion={resumir(part.description)} jsonLd={jsonLd}>
  <a href="/" class="text-sm text-accent hover:underline">Todas las partes</a>

  <div class="mt-3 flex items-start justify-between gap-4">
    <div>
      <div class="text-xs font-medium text-ink/44">{partLabel(part)}</div>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-ink">{part.title}</h1>
    </div>
    <LevelBadge level={part.level} />
  </div>

  <p class="mt-3 text-ink/70">{part.description}</p>

  {
    part.sources && part.sources.length > 0 && (
      <p class="mt-2 text-sm text-ink/44">
        Fuente:{' '}
        {part.sources.map((s, i) => (
          <span>
            {i > 0 && ', '}
            <a href={s.url} target="_blank" rel="noreferrer" class="underline hover:text-ink/70">
              {s.label}
            </a>
          </span>
        ))}
      </p>
    )
  }

  <div class="mt-8 flex flex-col">
    {
      concepts.map((concept, i) => (
        <a
          href={`/conceptos/${concept.slug}`}
          class={`flex items-center justify-between py-3 hover:bg-ink/[0.02] ${i > 0 ? 'border-t border-ink/10' : ''}`}
        >
          <span class="text-ink/80">
            <span class="mr-2 font-mono text-sm text-ink/44">{concept.id}</span>
            <InlineMd texto={concept.title} />
          </span>
          <span class="shrink-0">
            <LevelBadge level={concept.level} />
          </span>
        </a>
      ))
    }
  </div>
</Base>
