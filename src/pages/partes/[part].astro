---
import InlineMd from '../../components/InlineMd.astro';
import LevelBadge from '../../components/LevelBadge.astro';
import Base from '../../layouts/Base.astro';
import { getConceptsByPart } from '../../content/concepts';
import { getAllPartSlugs, getPartBySlug, partFullTitle, partLabel, type Part } from '../../content/parts';
import { resumir } from '../../lib/markdown';
import { migas, tituloDePagina, urlDePagina } from '../../lib/seo';

export const getStaticPaths = () =>
  getAllPartSlugs().map((part) => ({ params: { part } }));

const part = getPartBySlug(Astro.params.part) as Part;
const concepts = await getConceptsByPart(part.slug);
const titulo = partFullTitle(part);
const jsonLd = [
  migas([
    { nombre: 'Inicio', url: new URL('/', Astro.site) },
    { nombre: titulo, url: urlDePagina(Astro.url.pathname, Astro.site) },
  ]),
];
---

<Base titulo={tituloDePagina(titulo)} descripcion={resumir(part.description)} jsonLd={jsonLd}>
  <a href="/" class="text-sm text-accent-strong hover:underline">Todas las partes</a>

  <div class="mt-4 flex flex-col items-start gap-3 sm:flex-row sm:justify-between sm:gap-4">
    <div>
      <h1 class="text-3xl font-semibold leading-tight tracking-tight text-ink">
        {part.title.startsWith(partLabel(part)) ? part.title : <><span aria-hidden="true" class="mr-2 font-mono text-xl font-medium text-muted">{partLabel(part)}</span>{part.title}</>}
      </h1>
    </div>
    <LevelBadge level={part.level} />
  </div>

  <p class="mt-4 max-w-prose text-lg leading-relaxed text-ink/80">{part.description}</p>

  {
    part.sources && part.sources.length > 0 && (
      <p class="mt-2 text-sm text-muted">
        Fuente:{' '}
        {part.sources.map((s, i) => (
          <span>
            {i > 0 && ', '}
            <a href={s.url} target="_blank" rel="noreferrer" class="underline underline-offset-2 hover:text-ink">
              {s.label}
            </a>
          </span>
        ))}
      </p>
    )
  }

  <div class="mt-10 flex flex-col">
    {
      concepts.map((concept, i) => (
        <a
          href={`/conceptos/${concept.slug}`}
          class={`flex items-center justify-between gap-4 py-3.5 transition-colors hover:bg-ink/[0.03] ${i > 0 ? 'border-t border-line' : ''}`}
        >
          <span class="text-ink/80">
            <span class="mr-2 font-mono text-sm text-muted">{concept.id}</span>
            <InlineMd texto={concept.title} />
          </span>
          <span class="shrink-0">
            <LevelBadge level={concept.level} />
          </span>
        </a>
      ))
    }
  </div>
</Base>
