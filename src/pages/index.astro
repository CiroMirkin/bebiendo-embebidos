---
import LevelBadge from '../components/LevelBadge.astro';
import Base from '../layouts/Base.astro';
import { partLabel, parts } from '../content/parts';
import { DESCRIPCION_SITIO, NOMBRE_SITIO } from '../lib/seo';

const sitio = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: NOMBRE_SITIO,
  description: DESCRIPCION_SITIO,
  inLanguage: 'es',
  url: Astro.site?.href,
};
---

<Base titulo={NOMBRE_SITIO} descripcion={DESCRIPCION_SITIO} jsonLd={[sitio]}>
  <h1 class="max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">
    Roadmap: Arduino, ESP32, C++ y backend para varias organizaciones
  </h1>
  <p class="mt-5 max-w-prose text-lg leading-relaxed text-ink/80">
    Un recorrido para aprender a construir un sistema completo de equipos
    conectados, de punta a punta. El ejemplo que atraviesa todas las
    lecciones es el control de un invernadero: nodos sensores a batería que
    miden por BLE, un controlador ESP32 que maneja el riego y la
    ventilación, y un backend en Node y PostgreSQL que atiende a varios
    productores, cada uno con sus invernaderos y sus usuarios.
  </p>
  <p class="mt-4 max-w-prose text-lg leading-relaxed text-ink/80">
    Cada concepto es una lección: la idea central, por qué importa, un paso
    a paso, ejemplos de código, errores comunes, un ejercicio y un quiz para
    comprobar lo que entendiste. Si sabés programar pero no C++, empezá por
    la Base y la Parte 0.
  </p>

  <div class="mt-12 flex flex-col gap-3">
    {
      parts.map((part) => (
        <a
          href={`/partes/${part.slug}`}
          class="group block rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent/50"
        >
          <div class="flex flex-col items-start gap-3 sm:flex-row sm:justify-between sm:gap-4">
            <div>
              <h2 class="text-lg font-semibold tracking-tight text-ink group-hover:text-accent-strong">
                <span class="mr-1.5 font-mono text-sm font-medium text-muted">{partLabel(part)}</span>{part.title}
              </h2>
              <p class="mt-1 text-sm leading-relaxed text-muted">{part.description}</p>
            </div>
            <LevelBadge level={part.level} />
          </div>
        </a>
      ))
    }
  </div>
</Base>
