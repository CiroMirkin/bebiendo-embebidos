---
import Base from '../layouts/Base.astro';
import { tituloDePagina } from '../lib/seo';
---

<Base titulo={tituloDePagina('Página no encontrada')} descripcion="Esta página no existe en el roadmap.">
  <div class="py-10 sm:py-16">
    <p class="font-mono text-6xl font-semibold tracking-tight text-accent sm:text-7xl" aria-hidden="true">404</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink">Esta página no existe</h1>
    <p class="mt-3 max-w-prose text-lg text-ink/75">
      Puede que la lección haya cambiado de nombre o que la dirección tenga un error.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-ink px-5 py-2.5 font-medium text-canvas transition-colors hover:bg-accent-strong"
    >
      Volver al inicio
    </a>
  </div>
</Base>
