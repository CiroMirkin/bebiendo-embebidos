---
import Base from '../layouts/Base.astro';
import { tituloDePagina } from '../lib/seo';
---

<Base titulo={tituloDePagina('Página no encontrada')} descripcion="Esta página no existe en el roadmap.">
  <div class="mx-auto max-w-[56rem] py-8 sm:py-16">
    <p class="font-sans text-sm text-muted">Error 404</p>
    <h1 class="serif mt-2 text-4xl font-semibold leading-tight tracking-tight text-ink sm:text-5xl">
      Esta página no está en el cuaderno
    </h1>
    <p class="serif mt-5 text-xl leading-relaxed text-ink/80">
      Puede que la lección haya cambiado de nombre o que la dirección tenga un error. Volvé al índice y buscala por parte.
    </p>
    <p class="mt-8">
      <a href="/" class="serif text-lg text-accent-strong underline underline-offset-4 decoration-1 hover:decoration-2">
        Volver al índice
      </a>
    </p>
  </div>
</Base>
