---
import { toSentenceCase } from '../lib/format';

// Texto pequeño y discreto. Con `habitual`, solo aparece si el nivel difiere del de la parte.
type Props = { level: string; habitual?: string; etiqueta?: boolean };

const { level, habitual, etiqueta = false } = Astro.props;
const visible = habitual === undefined || habitual !== level;
const texto = toSentenceCase(level);
---

{
  visible && (
    <span class="whitespace-nowrap font-sans text-xs text-muted">
      {etiqueta ? `Nivel: ${texto.toLowerCase()}` : texto}
    </span>
  )
}
