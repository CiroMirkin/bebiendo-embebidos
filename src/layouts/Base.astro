---
import '../styles.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { NOMBRE_SITIO, serializarJsonLd, urlDePagina } from '../lib/seo';

type Props = {
  titulo: string;
  descripcion: string;
  tipo?: 'website' | 'article';
  jsonLd?: object[];
};

const { titulo, descripcion, tipo = 'website', jsonLd = [] } = Astro.props;
const canonica = urlDePagina(Astro.url.pathname, Astro.site);
const imagen = new URL('/images/og.png', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fffcf0" />
    <meta name="google-site-verification" content="d3wAK9U-HAs1sV3hApwtn9Xjhv1wZQdyu5QZr4fXdWQ" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica.href} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={NOMBRE_SITIO} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica.href} />
    <meta property="og:image" content={imagen.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    {jsonLd.map((datos) => <script type="application/ld+json" set:html={serializarJsonLd(datos)} />)}
  </head>
  <body class="bg-canvas">
    <div class="flex min-h-svh flex-col bg-canvas font-sans text-ink/90">
      <a
        href="#contenido"
        class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-20 focus:rounded-sm focus:bg-ink focus:px-4 focus:py-2 focus:text-canvas"
        >Saltar al contenido</a
      >
      <Header />
      <main id="contenido" class="mx-auto w-full max-w-6xl flex-1 px-5 py-10 sm:px-6 sm:py-14">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
